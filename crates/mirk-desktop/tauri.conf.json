{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirk",
  "version": "0.0.1",
  "identifier": "dev.mirk.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mirk",
        "width": 430,
        "height": 844,
        "minWidth": 430,
        "minHeight": 844,
        "maxWidth": 430,
        "maxHeight": 844,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
