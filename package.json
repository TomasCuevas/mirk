{
  "name": "oct",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Cross-platform PDF reading-progress tracker",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config web/vite.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}
