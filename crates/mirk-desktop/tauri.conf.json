{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirk",
  "version": "0.0.1",
  "identifier": "dev.mirk.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun crates/mirk-desktop/scripts/require-pdfium-resource.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mirk",
        "width": 634,
        "height": 844,
        "minWidth": 430,
        "minHeight": 844,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "publisher": "Tomás Cuevas",
    "homepage": "https://github.com/TomasCuevas/mirk",
    "shortDescription": "Track how far you have read in every PDF you own.",
    "longDescription": "mirk keeps a library of the PDFs you read and remembers how far into each one you got, so reading progress stops dying with the window you closed it in. It recovers progress your other viewers already recorded, renders covers, and keeps folders you nominate in sync. Reading progress is stored with its provenance, so a page counted by the built-in reader, one typed in by hand and one read back from an external viewer are never confused.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/pdfium/lib/*": "pdfium/"
    }
  }
}
